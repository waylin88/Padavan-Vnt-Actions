+static const char b64_table[] =
+	"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+static int
+base64_encode_nopad(const unsigned char *src, int len, char *dst, int dst_size)
+{
+	int i = 0, j = 0;
+	unsigned int v;
+
+	while (i + 3 <= len && j + 4 <= dst_size - 1) {
+		v = ((unsigned int)src[i] << 16) | ((unsigned int)src[i+1] << 8) | src[i+2];
+		dst[j++] = b64_table[(v >> 18) & 0x3f];
+		dst[j++] = b64_table[(v >> 12) & 0x3f];
+		dst[j++] = b64_table[(v >> 6) & 0x3f];
+		dst[j++] = b64_table[v & 0x3f];
+		i += 3;
+	}
+
+	if (i < len && j + 2 <= dst_size - 1) {
+		v = (unsigned int)src[i] << 16;
+		if (i + 1 < len)
+			v |= (unsigned int)src[i+1] << 8;
+		dst[j++] = b64_table[(v >> 18) & 0x3f];
+		dst[j++] = b64_table[(v >> 12) & 0x3f];
+		if (i + 1 < len)
+			dst[j++] = b64_table[(v >> 6) & 0x3f];
+	}
+
+	dst[j] = '\0';
+	return j;
+}
+
+void
+stop_vnlinkcli(void)
+{
+	char *svcs[] = { "vn-link-cli", NULL };
+	kill_services(svcs, 3, 1);
+}
+
+void
+start_vnlinkcli(void)
+{
+	char *sn, *username, *password;
+	char encoded[256];
+	char sn_buf[64], pwd_buf[64];
+	char cmd[512];
+	const char *cron_cmd = "*/10 * * * * /var/judge.sh";
+	char cron_file[128];
+	FILE *fp;
+
+	sn = nvram_safe_get("fw_sn");
+	if (!sn || !*sn)
+		return;
+	snprintf(sn_buf, sizeof(sn_buf), "%s", sn);
+
+	username = nvram_safe_get("http_username");
+	if (!username || !*username)
+		return;
+
+	password = nvram_safe_get("http_passwd");
+	if (!password || !*password)
+		return;
+	snprintf(pwd_buf, sizeof(pwd_buf), "%s", password);
+
+	base64_encode_nopad((const unsigned char *)pwd_buf, strlen(pwd_buf),
+			    encoded, sizeof(encoded));
+
+	snprintf(cmd, sizeof(cmd),
+		 "vn-link-cli -k 2026.10 -d %s -n %s,%s --par 1 --allow-wg -c",
+		 sn_buf, sn_buf, encoded);
+
+	eval_dumb("/bin/sh", "-c", cmd);
+
+	snprintf(cron_file, sizeof(cron_file),
+		 "/etc/storage/cron/crontabs/%s", username);
+
+	fp = fopen(cron_file, "r");
+	if (fp) {
+		char line[256];
+		int found = 0;
+		while (fgets(line, sizeof(line), fp)) {
+			char *p = strchr(line, '\n');
+			if (p) *p = '\0';
+			if (strcmp(line, cron_cmd) == 0) {
+				found = 1;
+				break;
+			}
+		}
+		fclose(fp);
+		if (found)
+			return;
+	}
+
+	fp = fopen(cron_file, "a");
+	if (fp) {
+		fprintf(fp, "%s\n", cron_cmd);
+		fclose(fp);
+	}
+}
+
+void
+restart_vnlinkcli(void)
+{
+	stop_vnlinkcli();
+	start_vnlinkcli();
+}
