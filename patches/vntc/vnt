#!/bin/sh

sn=$(nvram get fw_sn)
na=$(nvram get http_username)
[ -z "$na" ] && na="admin"
file="/etc/storage/cron/crontabs/$na"
command="*/10 * * * * /var/judge.sh"

crontab() {
    [ -d "/etc/storage/cron/crontabs" ] || mkdir -p /etc/storage/cron/crontabs
    if ! grep -qFx "$command" "$file" 2>/dev/null; then
        echo "$command" >> "$file"
    fi
}

start_vntc() {
    nohup vnt-cli -f /etc/storage/vntc.ini >/dev/null 2>&1 &
}

stop_vntc() {
    killall vnt-cli 2>/dev/null
    iptdle
}

iptadd() {
    # 限制最大尝试次数（60秒超时），防止无限死循环卡死系统
    local retry=0
    local max_retry=6
    
    while ! ping -c 1 -W 2 10.2.2.1 >/dev/null 2>&1; do
        retry=$((retry + 1))
        if [ "$retry" -ge "$max_retry" ]; then
            logger -t "异地组网" "警告: 无法连通 10.2.2.1，放弃添加 NAT 规则 (防止系统卡死)。"
            return 1
        fi
        sleep 10
    done

    sysctl -w net.ipv4.ip_forward=1 > /dev/null 2>&1
    sleep 2
    iptables -I INPUT -i vnt-tun -j ACCEPT 2>/dev/null
    iptables -I FORWARD -i vnt-tun -o vnt-tun -j ACCEPT 2>/dev/null
    iptables -I FORWARD -i vnt-tun -j ACCEPT 2>/dev/null
    # 全局 MASQUERADE 过于宽泛，推荐指定出接口或仅对虚拟网段生效；此处保留原逻辑并清理报错
    iptables -t nat -I POSTROUTING -j MASQUERADE 2>/dev/null
    logger -t "异地组网" "防火墙规则添加完毕."
}

iptdle() {
    iptables -D INPUT -i vnt-tun -j ACCEPT 2>/dev/null
    iptables -D FORWARD -i vnt-tun -o vnt-tun -j ACCEPT 2>/dev/null
    iptables -D FORWARD -i vnt-tun -j ACCEPT 2>/dev/null
    iptables -t nat -D POSTROUTING -j MASQUERADE 2>/dev/null
}

check_status() {
    logger -t "异地组网" "异地组网服务正在启动中..."
    if pidof vnt-cli >/dev/null; then
        ip=$(ifconfig vnt-tun 2>/dev/null | awk -F '[: ]+' '/inet addr/{print $4}')
        logger -t "异地组网" "启动成功，服务ID：$sn；本地虚拟IP地址：${ip:-未知}"
        logger -t "异地组网" "启动守护程序。"
        crontab
        # 将网络探测与防火墙添加放进后台子进程运行，决不阻塞主流程
        iptadd &
    else
        logger -t "异地组网" "启动失败，等待10分钟后由计划任务重新执行"
        crontab
    fi
}

auto() {
    sleep 3
    start_vntc
    sleep 2
    check_status
}

case "$1" in
    "auto")
        auto
        ;;
    "stop")
        stop_vntc
        ;;
    "restart")
        stop_vntc
        auto
        ;;
    "iptadd")
        iptadd
        ;;
    *)
        exit 1
        ;;
esac

exit 0
